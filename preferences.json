  },
  {
    "type": "text",
    "label": "**Loading animations**",
    "margin": "16px 0 10px 0",
    "size": "15px"
  },
  {
    "type": "checkbox",
    "property": "zen-flow.show-top-bar",
    "label": "Show the slim top loading bar while the current tab loads",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "property": "zen-flow.animate-loading-tabs",
    "label": "Animate the outline of tabs that are loading",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "property": "zen-flow.hide-native-loading-bar",
    "label": "Hide Zen's built-in loading bar while this mod is active (avoids two indicators)",
    "defaultValue": true
  },
  {
    "type": "text",
    "label": "**URL bar**",
    "margin": "16px 0 10px 0",
    "size": "15px"
  },
  {
    "type": "checkbox",
    "property": "zen-flow.blur-behind-popup",
    "label": "Blur the page behind the URL bar popup (blur-behind-urlbar)",
