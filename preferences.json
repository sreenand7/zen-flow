[
  {
    "type": "separator",
    "label": "**New tab clock**",
    "margin": "2px 0 8px 0",
    "size": "15px"
  },
  {
    "type": "string",
    "property": "zen-flow.message",
    "label": "Message shown under the clock",
    "placeholder": "Make today count.",
    "defaultValue": "Make today count."
  },
  {
    "type": "checkbox",
    "property": "zen-flow.show-clock",
    "label": "Show the date, clock and message on new tabs",
    "defaultValue": true
  },
  {
    "type": "string",
    "property": "zen-flow.clock-color",
    "label": "Clock colour — any CSS colour, or empty to follow the theme",
    "placeholder": "Automatic",
    "defaultValue": ""
  },
  {
    "type": "separator",
    "label": "**Top loading bar**",
    "margin": "16px 0 8px 0",
    "size": "15px"
  },
  {
    "type": "checkbox",
    "property": "zen-flow.show-top-bar",
    "label": "Show the slim loading bar at the top of the window",
    "defaultValue": true
  },
  {
    "type": "dropdown",
    "property": "zen-flow.bar-offset",
    "label": "Distance from the top edge of the window",
    "placeholder": false,
    "defaultValue": "3",
    "options": [
      { "label": "0 px — flush with the top edge", "value": "0" },
      { "label": "2 px", "value": "2" },
      { "label": "3 px (default)", "value": "3" },
      { "label": "4 px", "value": "4" },
      { "label": "6 px", "value": "6" },
      { "label": "8 px", "value": "8" },
      { "label": "12 px", "value": "12" }
    ]
  },
  {
    "type": "string",
    "property": "zen-flow.bar-color-a",
    "label": "Bar colour — left stop",
    "placeholder": "#4aa8ff",
    "defaultValue": "#4aa8ff"
  },
  {
    "type": "string",
    "property": "zen-flow.bar-color-b",
    "label": "Bar colour — middle stop",
    "placeholder": "#6fe3ff",
    "defaultValue": "#6fe3ff"
  },
  {
    "type": "string",
    "property": "zen-flow.bar-color-c",
    "label": "Bar colour — right stop",
    "placeholder": "#a8f4ff",
    "defaultValue": "#a8f4ff"
  },
  {
    "type": "string",
    "property": "zen-flow.bar-glow",
    "label": "Glow colour around the bar",
    "placeholder": "rgba(90, 190, 255, 0.35)",
    "defaultValue": "rgba(90, 190, 255, 0.35)"
  },
  {
    "type": "separator",
    "label": "**Loading tab outline**",
    "margin": "16px 0 8px 0",
    "size": "15px"
  },
  {
    "type": "checkbox",
    "property": "zen-flow.animate-loading-tabs",
    "label": "Outline tabs while they are loading",
    "defaultValue": true
  },
  {
    "type": "dropdown",
    "property": "zen-flow.tab-animation",
    "label": "Outline animation",
    "placeholder": false,
    "defaultValue": "pulse",
    "options": [
      { "label": "Pulse — smooth, composited (default)", "value": "pulse" },
      { "label": "Rotating gradient — heavier on the main thread", "value": "rotate" },
      { "label": "Static — no animation", "value": "static" }
    ]
  },
  {
    "type": "string",
    "property": "zen-flow.tab-color-a",
    "label": "Outline colour — start",
    "placeholder": "#4aa8ff",
    "defaultValue": "#4aa8ff"
  },
  {
    "type": "string",
    "property": "zen-flow.tab-color-b",
    "label": "Outline colour — end",
    "placeholder": "#6fe3ff",
    "defaultValue": "#6fe3ff"
  },
  {
    "type": "separator",
    "label": "**Page loading**",
    "margin": "16px 0 8px 0",
    "size": "15px"
  },
  {
    "type": "checkbox",
    "property": "zen-flow.page-zoom",
    "label": "Zoom the page slightly while it loads, then ease back",
    "defaultValue": true
  },
  {
    "type": "dropdown",
    "property": "zen-flow.page-zoom-amount",
    "label": "Starting zoom",
    "placeholder": false,
    "defaultValue": "0.98",
    "options": [
      { "label": "99% — very subtle", "value": "0.99" },
      { "label": "98% — subtle (default)", "value": "0.98" },
      { "label": "97% — more noticeable", "value": "0.97" }
    ]
  },
  {
    "type": "separator",
    "label": "**Advanced History**",
    "margin": "16px 0 8px 0",
    "size": "15px"
  },
  {
    "type": "checkbox",
    "property": "zen-flow.history-enabled",
    "label": "Show the Enhanced History button in the toolbar",
    "defaultValue": true
  },
  {
    "type": "separator",
    "label": "**URL bar**",
    "margin": "16px 0 8px 0",
    "size": "15px"
  },
  {
    "type": "checkbox",
    "property": "zen-flow.blur-behind-popup",
    "label": "Blur the page behind the open URL bar popup",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "property": "zen-flow.hide-native-loading-bar",
    "label": "Hide Zen's built-in loading bar (avoids two indicators)",
    "defaultValue": true
  }
]
